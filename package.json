{
  "name": "omp-antigravity-bridge",
  "version": "1.13.1-omp",
  "description": "OMP port of @estebanforge/pi-antigravity-bridge. Gemini provider for Pi on the Antigravity ACP server (official Google ACP) or the stream-json agy CLI. Use antigravity/* models in Pi. Full /model picker support. Models runs Pi's tools. ToS safe to use.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "antigravity",
    "antigravity-acp",
    "agy",
    "gemini",
    "google",
    "google-acp",
    "acp",
    "agent-client-protocol",
    "mcp",
    "mcp-server",
    "provider",
    "streaming",
    "omp",
    "oh-my-pi"
  ],
  "license": "MIT",
  "author": {
    "name": "EstebanForge",
    "email": "esteban@attitude.cl",
    "url": "https://actitud.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trozzelle/omp-antigravity-bridge.git"
  },
  "type": "module",
  "files": [
    "extensions",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CHANGELOG-OMP.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@estebanforge/pi-ask-shared": "^0.1.6",
    "@estebanforge/pi-tui-dialogs": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "diff": "^8.0.4"
  },
  "private": true,
  "homepage": "https://github.com/trozzelle/omp-antigravity-bridge#readme",
  "bugs": {
    "url": "https://github.com/trozzelle/omp-antigravity-bridge/issues"
  },
  "omp": {
    "extensions": [
      "./dist/omp-antigravity-bridge.js"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bunx --bun vitest run",
    "smoke:omp": "bash scripts/omp/smoke-load.sh",
    "build:bundle": "bun scripts/omp/build-bundle.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-tui": "^1.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typebox": "^1.3.4",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0",
    "@types/semver": "^7.7.0",
    "semver": "^7.7.0"
  }
}
